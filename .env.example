# ─────────────────────────────────────────────────────────────
#  arb-scanner configuration.  Copy to `.env` and edit.
#  Detection works with NO keys. Keys are only needed for LIVE trading.
# ─────────────────────────────────────────────────────────────

# Comma-separated CCXT exchange ids to scan, OR the special value `all` to fan
# out to ~40 curated spot venues. See https://docs.ccxt.com for supported ids.
# (e.g. Gate.io is `gate`, HTX is `htx`.)
EXCHANGES=all

# Pairs to watch. Either an explicit list, OR `auto` to discover every pair
# listed on >= MIN_VENUES connected exchanges. `auto` is where real gaps show up
# — it scans the long tail, not just BTC/ETH.
SYMBOLS=auto

# Auto-discovery tuning (only used when SYMBOLS=auto):
QUOTE_CURRENCIES=USDT   # comma-separated quote currencies to include, e.g. USDT,USDC
MIN_VENUES=2            # a pair must be listed on at least this many venues
MAX_SYMBOLS=300         # cap on how many pairs to scan per cycle

# How often to scan, in milliseconds. Raise this (8000-15000) for big scans.
POLL_INTERVAL_MS=8000

# ── Strategy / risk ──────────────────────────────────────────
# Minimum NET profit (after both taker fees) to consider a gap tradable, in %.
MIN_NET_PROFIT_PCT=0.3
# Sanity filters — drop fake "opportunities" from bad data.
# Discard a venue whose price deviates more than this % from the cross-venue
# median (kills stale feeds and same-ticker-different-token collisions).
OUTLIER_DEVIATION_PCT=5
# Never auto-trade a spread wider than this % — it's illiquid/un-exitable, not free money.
MAX_SANE_SPREAD_PCT=5
# Max notional per single arbitrage trade, in USD.
MAX_TRADE_USD=100
# Max total notional deployed per scan cycle, in USD.
MAX_OPEN_USD=500
# Stop trading for the day once realized P&L drops below -this, in USD.
DAILY_LOSS_LIMIT_USD=50
# Conservative slippage haircut applied to each leg in PAPER fills, in %.
MAX_SLIPPAGE_PCT=0.1
# Fallback taker fee if an exchange doesn't report one (fraction, 0.001 = 0.1%).
DEFAULT_TAKER_FEE=0.001

# ── Paper-trading seed balances (simulation only) ────────────
# Starting USDT per exchange, and starting per-coin inventory per exchange (USD value).
PAPER_START_USDT=1000
PAPER_SEED_INVENTORY_USD=500

# ── Dashboard ────────────────────────────────────────────────
PORT=3000

# ─────────────────────────────────────────────────────────────
#  LIVE TRADING (real money). Leave MODE=paper until you have
#  watched paper mode trade profitably for days. To go live you
#  must set BOTH of these:
# ─────────────────────────────────────────────────────────────
MODE=paper
CONFIRM_LIVE=false

# Per-exchange API keys. ONLY needed for MODE=live.
# SECURITY: create keys with TRADE permission only — NEVER withdrawal.
# Restrict keys to your IP address in the exchange's API settings.
# Format: <EXCHANGEID>_API_KEY / <EXCHANGEID>_SECRET / <EXCHANGEID>_PASSWORD
#
# BINANCE_API_KEY=
# BINANCE_SECRET=
# KRAKEN_API_KEY=
# KRAKEN_SECRET=
# OKX_API_KEY=
# OKX_SECRET=
# OKX_PASSWORD=
# KUCOIN_API_KEY=
# KUCOIN_SECRET=
# KUCOIN_PASSWORD=

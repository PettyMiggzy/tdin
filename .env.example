# ---- Solana RPC (required) ----
# Use your own mainnet RPC (Alchemy / Helius / QuickNode)
SOLANA_RPC_URL=https://your-mainnet-rpc-here

# ---- Wallet (optional: seed one wallet from env) ----
# You can also add/switch wallets in the dashboard UI instead.
# WALLET_SECRET=your_base58_private_key
# WALLET_SECRETS=key1,key2   # multiple wallets to choose between (one active at a time)

# ---- Buy defaults (editable live in the UI) ----
DEFAULT_AMOUNT_SOL=0.01     # SOL per buy
DEFAULT_DELAY_SEC=3         # seconds between buys (snipe/batch)
DEFAULT_SLIPPAGE_BPS=1000   # 1000 = 10%
MAX_SPEND_SOL=0.5           # hard cap on total live spend per session
PRIORITY_FEE_MODE=auto      # auto | fixed
PRIORITY_FEE_MICROLAMPORTS=100000

# ---- Safety ----
DRY_RUN=true                # true = simulate buys (get quotes, no spend). Flip to false to go live.

# ---- Sniper ----
SNIPE_MAX_BUYS=5            # max auto-buys per run
SNIPE_POLL_SEC=5           # how often to check for new launches
# LAUNCH_FEED_URL=          # optional JSON feed of new token mints for snipe mode

# ---- Server ----
PORT=3000
# DASHBOARD_TOKEN=set-a-secret-before-deploying-publicly
